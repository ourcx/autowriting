# AI 自动写作系统 - 环境变量配置示例
# 复制此文件为 .env，然后填入实际的 API 密钥

# ============================================
# 服务器配置
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# MaaS API 配置（小红书内部服务）
# ============================================
# 用于文章生成的 DeepSeek v4 Pro 模型
MAAS_API_KEY=your_maas_api_key_here
MAAS_BASE_URL=https://maas.devops.xiaohongshu.com/v1
MAAS_USER_EMAIL=your_email@xiaohongshu.com
MAAS_APP_ID=qs-api

# ============================================
# Stability AI 配置
# ============================================
# 用于高质量图片生成
# 获取 API Key: https://platform.stability.ai/account/keys
STABILITY_API_KEY=your_stability_api_key_here
STABILITY_BASE_URL=https://api.stability.ai/v1
STABILITY_ENGINE=stable-diffusion-3-large

# ============================================
# OpenAI 配置
# ============================================
# 用于 DALL-E 3 图片生成（可选）
# 获取 API Key: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=dall-e-3

# ============================================
# 图片管理系统配置
# ============================================
# 图片存储目录（相对于项目根目录）
IMAGES_DIR=.cache/images
# 图片元数据文件路径
IMAGES_METADATA_FILE=.cache/images_metadata.json
# 最大图片存储数量
MAX_IMAGES=500

# ============================================
# 缓存配置
# ============================================
# 封面生成缓存目录
CACHE_DIR=.cache/covers
# 生成历史文件路径
HISTORY_FILE=.cache/cover_history.json

# ============================================
# 文件系统配置
# ============================================
# 草稿目录
DRAFTS_DIR=公众号写作/drafts
# AGENTS 规范文件路径
AGENTS_FILE=AGENTS.md
