#!/usr/bin/env bash
# ───────────────────────────────────────────────────────────────────────
# commit-msg hook —— Conventional Commits 格式校验
#
# 允许：feat / fix / docs / style / refactor / perf / test / chore / build / ci / revert
# 可选 scope：feat(api): xxx
# ───────────────────────────────────────────────────────────────────────

MSG_FILE="$1"
FIRST_LINE=$(head -n1 "$MSG_FILE")

# Merge / Revert / fixup 自动放行
if echo "$FIRST_LINE" | grep -qE '^(Merge|Revert|fixup!|squash!)'; then
  exit 0
fi

PATTERN='^(feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert)(\([a-z0-9_/.-]+\))?: .{1,}$'

if ! echo "$FIRST_LINE" | grep -qE "$PATTERN"; then
  echo ""
  echo "❌ commit message 不符合 Conventional Commits 规范"
  echo ""
  echo "当前: $FIRST_LINE"
  echo ""
  echo "✅ FIX：格式应为 'type: description' 或 'type(scope): description'"
  echo "   type ∈ feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert"
  echo "   示例:"
  echo "     feat(articles): 支持 SSE 流式生成"
  echo "     fix: 修复 wechat 草稿目录隔离"
  echo "     docs(agents): 更新 conventions.md"
  echo ""
  echo "📖 See: docs/agents/conventions.md#git-提交"
  exit 1
fi
