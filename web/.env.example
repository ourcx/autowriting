# ============================================================
# autowriting — 服务端环境变量示例
# 复制为 .env 后填入真实值，重启 server 生效
#
# 注意：大部分配置可以在浏览器的「AI 配置」页面完成，
#       无需修改此文件。此文件适合服务端统一部署场景。
# ============================================================

# 服务端口（默认 3000）
PORT=3000

# ── 目录配置（独立部署时可自定义，默认使用项目根目录下的路径）──
# PROJECT_ROOT=/data/autowriting
# DRAFTS_DIR=/data/autowriting/drafts
# DATA_DIR=/data/autowriting/.cache

# ── 文章生成（优先使用浏览器「AI 配置」页设置，以下作为服务端兜底）──
# 服务商：openai | openai-compat | maas
ARTICLE_PROVIDER=openai
ARTICLE_API_KEY=sk-your-openai-key-here
ARTICLE_BASE_URL=https://api.openai.com/v1
ARTICLE_MODEL=gpt-4o

# 如果用 OpenAI 兼容接口（如 DeepSeek、Claude 等）
# ARTICLE_BASE_URL=https://api.deepseek.com/v1
# ARTICLE_MODEL=deepseek-chat

# ── 封面生成（默认 local，免费 SVG 占位）──
# COVER_PROVIDER=openai
# COVER_API_KEY=sk-your-key

# DALL-E / OpenAI（封面生成同一个 key）
# OPENAI_API_KEY=sk-your-openai-key-here

# Stability AI（可选）
# STABILITY_API_KEY=sk-your-stability-key-here
# STABILITY_BASE_URL=https://api.stability.ai/v1

# ── MaaS 内部（小红书内部使用）──
# MAAS_API_KEY=
# MAAS_BASE_URL=https://maas.devops.xiaohongshu.com/v1
# MAAS_USER_EMAIL=

# ── Imgur 图床（可选，不填则图片存本地）──
# 前往 https://api.imgur.com/oauth2/addclient 注册应用（选 OAuth2 without callback），获取 Client ID
# IMGUR_CLIENT_ID=your-imgur-client-id
