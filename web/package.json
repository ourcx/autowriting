{
  "name": "autowriting-web",
  "version": "1.0.0",
  "description": "AI 自动写作系统 - Web 版本",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "sync": "bash sync-to-guard.sh",
    "postinstall": "node scripts/postinstall.cjs",
    "rebuild:native": "node scripts/postinstall.cjs",

    "electron:dev": "concurrently --kill-others -n server,vite,electron \"node server.js\" \"vite\" \"wait-on http://localhost:5173 http://localhost:3000/health && NODE_ENV=development electron .\"",
    "electron:build": "ELECTRON=true vite build && npx electron-builder build --config electron-builder.config.cjs",
    "electron:build:mac": "ELECTRON=true vite build && npx electron-builder build --mac --config electron-builder.config.cjs",
    "electron:build:win": "ELECTRON=true vite build && npx electron-builder build --win --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@langchain/community": "^1.1.28",
    "@langchain/openai": "^1.4.5",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "dompurify": "^3.0.6",
    "easymde": "^2.18.0",
    "form-data": "^4.0.5",
    "highlight.js": "^11.11.1",
    "hnswlib-node": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.4.0",
    "lucide-react": "^0.263.1",
    "markdown-it": "^14.1.1",
    "marked": "^11.1.1",
    "multer": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "express": "^4.18.2",
    "typescript": "^5.1.0",
    "vite": "^4.4.0",
    "wait-on": "^9.0.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "hnswlib-node",
      "esbuild"
    ]
  }
}
