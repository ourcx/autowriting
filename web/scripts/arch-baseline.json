{
  "_doc": "Harness Engineering 存量豁免清单。格式：'<相对仓库根路径>::<rule>'。新增违规禁止加入，必须修复。",
  "_rules": [
    "route-auth-missing：路由未挂 authMiddleware（可能是逐路由 adminMiddleware，或确实缺鉴权）",
    "route-direct-db：路由直连 sqlite",
    "component-import-store：组件 import store",
    "component-import-page：组件反向引 page",
    "page-bare-fetch：页面/组件裸 fetch（应走 apiHelpers）",
    "route-too-big：路由文件超 800 行"
  ],
  "_cleanup_priority": {
    "P0_security": [
      "web/server/routes/covers.js::route-auth-missing",
      "web/server/routes/images.js::route-auth-missing",
      "web/server/routes/settings.js::route-auth-missing",
