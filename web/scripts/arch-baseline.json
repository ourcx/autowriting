      "web/server/routes/monitoring.js::route-auth-missing",
      "web/server/routes/prompts.js::route-auth-missing",
      "web/server/routes/publish.js::route-auth-missing",
      "web/server/routes/toutiao.js::route-auth-missing"
    ],
    "P2_refactor": "page-bare-fetch 系列：逐步替换为 apiHelpers，先做 6 个高频组件"
